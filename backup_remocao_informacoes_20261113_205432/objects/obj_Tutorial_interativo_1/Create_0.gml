if (instance_number(obj_Tutorial_interativo_1) > 1) { instance_destroy(); exit; }
persistent = true; depth = -15000; ativo = false; etapa = 0; espera = 0.2; pulsacao = 0;
alvo_objeto = function() { switch (etapa) { case 1: return obj_btn_Tela_aprimoramentos_fora_1; case 2: return obj_btn_Tela_up_especificos_fora_1; case 3: return obj_btn_md_Cube; case 4: return obj_btn_Tela_principal_fora_1; } return noone; };
avancar = function() { etapa++; espera = 0.2; if (etapa > 6) { ativo = false; global.tutorial_f1_concluido = true; } };
retangulo_alvo = function() { var _obj = alvo_objeto(); if (_obj != noone && instance_exists(_obj)) { var _i = instance_find(_obj, 0); return [max(2,_i.bbox_left-7),max(2,_i.bbox_top-7),min(358,_i.bbox_right+7),min(638,_i.bbox_bottom+7)]; } if (etapa == 5) return [12,70,348,570]; return [35,230,325,540]; };
textos = [["BEM-VINDO À LAN HOUSE","WELCOME TO THE INTERNET CAFÉ","BIENVENIDO AL CIBERCAFÉ"],["ABRA AS MELHORIAS","OPEN UPGRADES","ABRE LAS MEJORAS"],["ESCOLHA UM FLIPERAMA","CHOOSE AN ARCADE","ELIGE UNA ARCADE"],["LIBERE O PRIMEIRO FLIPERAMA","UNLOCK YOUR FIRST ARCADE","DESBLOQUEA TU PRIMERA ARCADE"],["VOLTE À LAN HOUSE","RETURN TO THE INTERNET CAFÉ","VUELVE AL CIBERCAFÉ"],["ATENDA OS CLIENTES","SERVE YOUR CUSTOMERS","ATIENDE A TUS CLIENTES"],["AUMENTE A VELOCIDADE","SPEED UP THE SERVICE","ACELERA EL SERVICIO"]];
descricoes = [["Vamos conhecer os fliperamas, as melhorias e o atendimento. O quadrado iluminado mostrará onde você deve tocar.","Let's explore arcades, upgrades, and customer service. Tap the highlighted target.","Conoce las arcades, mejoras y atención. Toca el objetivo iluminado."],["Toque em Aprimoramentos na barra inferior.","Tap Upgrades on the bottom bar.","Toca Mejoras en la barra inferior."],["Abra as melhorias dos fliperamas.","Open the arcade upgrades.","Abre las mejoras específicas de las arcades."],["Vamos comprar seu primeiro fliperama! Toque no Cube World para comprar.","The first Cube World upgrade is free and unlocks its service station.","La primera mejora de Cube World es gratis y habilita su estación."],["Toque em Principal para voltar ao atendimento.","Tap Main to return to the customers.","Toca Principal para volver a atender."],["Os clientes entram na fila, esperam ser atendidos, usam o fliperama escolhido e pagam ao terminar de usar. Os toques aceleram os processos; Internet automatiza o atendimento.","Customers queue, use their chosen arcade, and pay when finished. Taps speed up service; Internet automates it.","Los clientes esperan, usan su arcade y pagan al terminar. Los toques aceleran; Internet automatiza."],["Internet automatiza e reduz o tempo. Upgrades dos fliperamas melhoram os ganhos. Toque Continuar para terminar.","Internet automates service and reduces time. Arcade upgrades improve earnings. Tap Continue to finish.","Internet automatiza y reduce el tiempo. Las mejoras aumentan ganancias. Toca Continuar."]];