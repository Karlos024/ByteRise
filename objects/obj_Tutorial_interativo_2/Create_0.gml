if (instance_number(obj_Tutorial_interativo_2)>1) { instance_destroy(); exit; }
persistent=true; depth=-15000; ativo=false; etapa=0; espera=0.2; pulsacao=0;
alvo_objeto=function(){ switch(etapa){ case 1:return obj_btn_Tela_aprimoramentos_fora_2; case 2:return obj_btn_Tela_up_especificos_fora_2; case 3:return obj_btn_md_HD_SSD; case 4:return obj_btn_Tela_principal_fora_2; } return noone; };
avancar=function(){ etapa++; espera=0.2; if(etapa==6) pratica_preparada=false; if(etapa>6){ ativo=false; global.tutorial_f2_concluido=true; } };
retangulo_alvo=function(){ var _obj=alvo_objeto(); if(_obj!=noone&&instance_exists(_obj)){var _i=instance_find(_obj,0); return [max(2,_i.bbox_left-7),max(2,_i.bbox_top-7),min(358,_i.bbox_right+7),min(638,_i.bbox_bottom+7)];} if(etapa==5)return [12,70,348,570]; if(etapa==6)return [12,340,348,565]; return [35,230,325,540]; };
textos = [["BEM-VINDO À ASSISTÊNCIA","WELCOME TO TECH SUPPORT","BIENVENIDO AL SERVICIO TÉCNICO"],["ABRA AS MELHORIAS","OPEN UPGRADES","ABRE LAS MEJORAS"],["ESCOLHA UMA BANCADA","CHOOSE A REPAIR BENCH","ELIGE UN BANCO DE REPARACIÓN"],["LIBERE HD/SSD","UNLOCK HD/SSD REPAIRS","HABILITA REPARACIONES DE HD/SSD"],["VOLTE AO ATENDIMENTO","RETURN TO THE WORKSHOP","VUELVE AL TALLER"],["ENTENDA O PEDIDO","UNDERSTAND THE COMPLAINT","ENTIENDE EL PEDIDO"],["FAÇA O PRIMEIRO ATENDIMENTO","MAKE YOUR FIRST REPAIR","HAZ LA PRIMERA REPARACIÓN"]];
descricoes = [["Vamos abrir uma bancada e conhecer o conserto. O destaque indica onde tocar.","Let’s unlock a repair bench and learn how repairs work. The highlight shows where to tap.","Vamos a habilitar un banco y conocer las reparaciones. El objetivo iluminado indica dónde tocar."],["Toque em Aprimoramentos na barra inferior.","Tap Upgrades on the bottom bar.","Toca Mejoras en la barra inferior."],["Abra as melhorias específicas das áreas de conserto.","Open the upgrades for the repair areas.","Abre las mejoras específicas de las áreas de reparación."],["A primeira melhoria de HD/SSD é grátis e libera essa bancada.","The first HD/SSD upgrade is free and unlocks this repair bench.","La primera mejora de HD/SSD es gratis y habilita este banco."],["Toque em Principal para voltar aos clientes e às bancadas.","Tap Main to return to the customers and repair benches.","Toca Principal para volver a los clientes y a los bancos."],["Leia a reclamação: falta de espaço indica HD/SSD; problema ao ligar indica fonte (PSU); imagem estranha indica placa de vídeo (GPU).","Read the complaint: low storage points to HD/SSD; trouble turning on points to the power supply (PSU); display problems point to the graphics card (GPU).","Lee el reclamo: la falta de espacio indica HD/SSD; los problemas al encender indican la fuente de alimentación (PSU); los problemas de imagen indican la tarjeta gráfica (GPU)."],["Leve o computador à área correta. Um conserto errado faz o cliente ir sem pagar. Toques aceleram; Energia automatiza o trabalho.","Take the computer to the correct work area. A wrong repair sends the customer away without paying. Taps speed things up; Energy automates the work.","Lleva el equipo al área correcta. Una reparación equivocada hace que el cliente se vaya sin pagar. Los toques aceleran el trabajo; Energía lo automatiza."]];

pratica_preparada=false; arrastou=false; pratica_concluida=false; cliente=noone;